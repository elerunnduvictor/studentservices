{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "trailingSlash": false,

  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "studentservicespm.vercel.app" }],
      "destination": "/signin.html",
      "permanent": false
    }
  ],

  "rewrites": [
    {
      "source": "/shared/:path*",
      "has": [{ "type": "host", "value": "studentservicespm.vercel.app" }],
      "destination": "/shared/:path*"
    },
    {
      "source": "/favicon.svg",
      "has": [{ "type": "host", "value": "studentservicespm.vercel.app" }],
      "destination": "/favicon.svg"
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "studentservicespm.vercel.app" }],
      "destination": "/pm/:path*"
    }
  ],

  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [{ "key": "Cache-Control", "value": "no-store, must-revalidate" }]
    },
    {
      "source": "/shared/js/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-store, must-revalidate" }]
    }
  ]
}
